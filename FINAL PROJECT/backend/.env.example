# Actual provider credentials can stay in FINAL PROJECT/.env.
OPENAI_API_KEY=
COURTLISTENER_API_KEY=
GOVINFO_API_KEY=
OPENSTATES_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Use a random value of at least 24 characters for hosted use.
BACKEND_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=5000
# Comma-separated exact frontend origins. No wildcard.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
