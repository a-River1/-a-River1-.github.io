    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Current HTML file",
            "file": "${file}",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Paralegal: start server"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Paralegal research app",
